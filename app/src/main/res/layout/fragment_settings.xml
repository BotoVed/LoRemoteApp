<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Секция: Конфиг -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="КОНФИГУРАЦИЯ"
            android:textSize="11sp"
            android:textColor="@color/gray_400"
            android:letterSpacing="0.1"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etConfig"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:hint="Вставьте window.LORA_CONFIG = { ... }"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textColor="@color/gray_300"
            android:textColorHint="@color/gray_600"
            android:background="@color/bg_input"
            android:padding="10dp"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnApplyConfig"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Применить конфиг"
            android:layout_marginBottom="16dp"/>

        <!-- Секция: BLE устройство -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BLE УСТРОЙСТВО"
            android:textSize="11sp"
            android:textColor="@color/gray_400"
            android:letterSpacing="0.1"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:layout_marginBottom="12dp"/>

        <Spinner
            android:id="@+id/spinnerDevices"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/bg_input"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Подключить"
            android:layout_marginBottom="16dp"/>

        <!-- Секция: Доставка команд -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ДОСТАВКА КОМАНД"
            android:textSize="11sp"
            android:textColor="@color/gray_400"
            android:letterSpacing="0.1"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="КОЛ-ВО ПОВТОРОВ ОТПРАВКИ"
            android:textSize="11sp"
            android:textColor="@color/gray_400"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <SeekBar
                android:id="@+id/seekRetryCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="5"
                android:progress="0"/>

            <TextView
                android:id="@+id/tvRetryCountLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 повторов (без повторов)"
                android:textSize="11sp"
                android:textColor="@color/gray_500"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ИНТЕРВАЛ ПОВТОРА (сек)"
            android:textSize="11sp"
            android:textColor="@color/gray_400"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <SeekBar
                android:id="@+id/seekRetryInterval"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="105"
                android:progress="15"
                android:enabled="false"
                android:alpha="0.4"/>

            <TextView
                android:id="@+id/tvRetryIntervalLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30 сек"
                android:textSize="11sp"
                android:textColor="@color/gray_500"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- Секция: Диагностика -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ДИАГНОСТИКА"
            android:textSize="11sp"
            android:textColor="@color/gray_400"
            android:letterSpacing="0.1"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnPing"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Проверить связь (PING)"
            android:layout_marginBottom="8dp"/>

  <TextView
            android:id="@+id/tvPingResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textColor="@color/gray_500"
            android:padding="8dp"
            android:background="@color/bg_input"
            android:layout_marginBottom="16dp"/>

        <!-- Секция: Очередь отправки -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ОЧЕРЕДЬ ОТПРАВКИ"
            android:textSize="11sp"
            android:textColor="@color/gray_400"
            android:letterSpacing="0.1"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/queueListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/bg_input"
            android:padding="8dp"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>
</ScrollView>
