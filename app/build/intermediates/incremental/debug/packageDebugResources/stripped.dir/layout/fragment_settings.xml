<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Секция: Конфиг -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="КОНФИГУРАЦИЯ"
            android:textSize="11sp"
            android:textColor="@color/gray_600"
            android:letterSpacing="0.1"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etConfig"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:hint="Вставьте window.LORA_CONFIG = { ... }"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textColor="@color/gray_300"
            android:textColorHint="@color/gray_600"
            android:background="@color/bg_elevated"
            android:padding="10dp"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnApplyConfig"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Применить конфиг"
            android:layout_marginBottom="20dp"/>

        <!-- Секция: BLE устройство -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BLE УСТРОЙСТВО"
            android:textSize="11sp"
            android:textColor="@color/gray_600"
            android:letterSpacing="0.1"
            android:layout_marginBottom="6dp"/>

        <Button
            android:id="@+id/btnScan"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Сканировать"
            android:layout_marginBottom="8dp"/>

        <Spinner
            android:id="@+id/spinnerDevices"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/bg_elevated"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Подключиться"
            android:layout_marginBottom="20dp"/>

        <!-- Секция: Диагностика -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ДИАГНОСТИКА"
            android:textSize="11sp"
            android:textColor="@color/gray_600"
            android:letterSpacing="0.1"
            android:layout_marginBottom="6dp"/>

        <Button
            android:id="@+id/btnPing"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Проверить связь (PING)"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvPingResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textColor="@color/gray_500"
            android:padding="8dp"
            android:background="@color/bg_elevated"/>

    </LinearLayout>
</ScrollView>
